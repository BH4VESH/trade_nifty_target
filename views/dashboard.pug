doctype html
html
  head
    title Trading Dashboard

    style.
      body {
        font-family: Arial;
        padding: 20px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 30px;
      }

      th {
        background: #222;
        color: white;
      }

      th, td {
        border: 1px solid #ddd;
        padding: 8px;
        text-align: center;
      }

      .bullish {
        background: #d4edda;
      }

      .bearish {
        background: #f8d7da;
      }

      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
      }

      .logout-btn {
        background: #dc2626;
        color: white;
        text-decoration: none;
        padding: 6px 20px;
        border-radius: 6px;
        margin-left: 15px;
      }

      .logout-btn:hover {
        background: #b91c1c;
      }

      .add-user-btn {
        background: #30b6d8;
        color: white;
        text-decoration: none;
        padding: 6px 20px;
        border-radius: 6px;
        margin-left: 15px;
      }

      .add-user-btn:hover {
        background: #3c97ad;
      }

      h3{
        margin-top:30px;
      }

      #PredictionSection {
        display: none;
      }

      //- stok css
      .filters {
          display: flex;
          align-items: center;
          gap: 12px;
          flex-wrap: nowrap;      /* Keep all controls in one row */
          margin: 20px 0;
          overflow-x: auto;       /* Scroll horizontally if screen is small */
          padding-bottom: 5px;
      }

      .filters {
          display: flex;
          align-items: center;
      }

      .filters > * {
          margin-right: 12px;
      }

      .filters > *:last-child {
          margin-right: 0;
      }
      
      .filters input[type="date"],
      .filters select {
          width: 180px;
          min-width: 180px;
          height: 42px;
          padding: 0 12px;
          border: 1px solid #ccc;
          border-radius: 6px;
          font-size: 14px;
          background: #fff;
      }
      
      .filters button {
          min-width: 120px;
          height: 42px;
          padding: 0 20px;
          border: none;
          border-radius: 6px;
          background: #457bcc;
          color: #fff;
          font-weight: 600;
          cursor: pointer;
      }
      
      .filters button:hover {
          background: #1c69db;
      }

      .table-container {
          width: 100%;
          max-height: 700px;      /* About 20 rows */
          overflow-y: auto;
          overflow-x: auto;
          border: 1px solid #ddd;
      }

      #stockTable {
          width: 100%;
          border-collapse: collapse;
      }

      #stockTable thead th {
          position: sticky;
          top: 0;
          background: #222;
          color: #fff;
          z-index: 10;
      }

      #stockTable th,
      #stockTable td {
          padding: 8px 12px;
          border: 1px solid #ddd;
          white-space: nowrap;
      }

  body

    .header
      .left
        h2 Trading Dashboard

      .right
        span Welcome #{username}
        a.logout-btn(href="/logout") Logout
        if canCreateUser
          a.add-user-btn(href="/add-user") Add User

    table#dashboard
      thead
        tr
          th Rank
          th Sector
          th Live
          th Open
          th G90
          th G180
          th G270
          th G360
          th Position
          th Strength
          th Target
          th Direction
          th Bot Direction
          th Bot Score
          th Combined Score
          th Signal

      tbody

      hr

    div#PredictionSection
      h2 Stock Analysis

      .filters
        input(type="date" id="stockDate")

        select#stockSector
          option(value="ALL") All Sectors

        select#stockView
          option(value="TOP5") Top 5
          option(value="TOP10") Top 10
          option(value="TOP20") Top 20
          option(value="BOTTOM5") Bottom 5
          option(value="BOTTOM10") Bottom 10
          option(value="ALL") All

        button(onclick="loadStocks()") Search
      hr
      .table-container
        table#stockTable
          thead
            tr
              th Rank
              th Sector
              th Company
              th Live
              th Open
              th G90
              th G180
              th G270
              th G360
              th Position
              th Strength
              th Direction
              th Score
              th Signal
          tbody

      h3 Today's Prediction

        table
          thead
            tr
              th Type
              th Sector
              th Signal
              th Score

          tbody
            tr
              td Best Sector
              td#todayBest Loading...
              td#todayBestSignal Loading...
              td#todayBestScore Loading...

            tr
              td Worst Sector
              td#todayWorst Loading...
              td#todayWorstSignal Loading...
              td#todayWorstScore Loading...

 
      h3 Tomorrow's Prediction
        table
          thead
            tr
              th Type
              th Sector
              th Signal
              th Score

          tbody
            tr
              td Best Sector
              td#tomorrowBest Loading...
              td#tomorrowBestSignal Loading...
              td#tomorrowBestScore Loading...

            tr
              td Worst Sector
              td#tomorrowWorst Loading...
              td#tomorrowWorstSignal Loading...
              td#tomorrowWorstScore Loading...

    script.

      async function loadData() {

        try {

          const response = await fetch('/api/dashboard');

          // Session expired or logged in elsewhere
          if (response.status === 401) {
          //- alert("Your account has been logged in from another device.");
          window.location.replace("/login");
          return;
          }
          const result = await response.json();

          const data = result.dashboard;
          const today = result.prediction ? result.prediction.today : null;
          const tomorrow = result.prediction ? result.prediction.tomorrow : null;
          const isShowPrediction = result.isShowPrediction ?? false;

          const tbody = document.querySelector('#dashboard tbody');
          const section = document.getElementById('PredictionSection');

          if (isShowPrediction) {
          section.style.display = "block";
          }

          tbody.innerHTML = '';

          data.forEach(row => {

            const tr = document.createElement('tr');

            tr.className =
              row.Direction === 'Bullish'
              ? 'bullish'
              : 'bearish';

            tr.innerHTML = `
              <td>${row.Rank}</td>
              <td>${row.Sector}</td>
              <td>${row.LivePrice}</td>
              <td>${row.DailyOpen}</td>
              <td>${row.Gann90}</td>
              <td>${row.Gann180}</td>
              <td>${row.Gann270}</td>
              <td>${row.Gann360}</td>
              <td>${row.Position}</td>
              <td>${row.Strength}</td>
              <td>${row.Target}</td>
              <td>${row.Direction}</td>
              <td>${row.N_Bias}</td>
              <td>${row.A_Score}</td>
              <td>${row.CombinedScore}</td>
              <td>${row.Signal}</td>
            `;

            tbody.appendChild(tr);

          });

          if(today){

            document.getElementById("todayBest").innerHTML =
              today.bestSector?.Sector || "-";

            document.getElementById("todayBestSignal").innerHTML =
              today.bestSector?.Signal || "-";

            document.getElementById("todayBestScore").innerHTML =
              today.bestSector?.CombinedScore ?? "-";

            document.getElementById("todayWorst").innerHTML =
              today.worstSector?.Sector || "-";

            document.getElementById("todayWorstSignal").innerHTML =
              today.worstSector?.Signal || "-";

            document.getElementById("todayWorstScore").innerHTML =
              today.worstSector?.CombinedScore ?? "-";

          }

          if(tomorrow){

            document.getElementById("tomorrowBest").innerHTML =
              tomorrow.bestSector?.Sector || "-";

            document.getElementById("tomorrowBestSignal").innerHTML =
              tomorrow.bestSector?.Signal || "-";

            document.getElementById("tomorrowBestScore").innerHTML =
              tomorrow.bestSector?.CombinedScore ?? "-";

            document.getElementById("tomorrowWorst").innerHTML =
              tomorrow.worstSector?.Sector || "-";

            document.getElementById("tomorrowWorstSignal").innerHTML =
              tomorrow.worstSector?.Signal || "-";

            document.getElementById("tomorrowWorstScore").innerHTML =
              tomorrow.worstSector?.CombinedScore ?? "-";

          }

        } catch(err){

          console.error(err);

        }

      }
      async function loadStocks() {
        try {
          const date =
            document.getElementById("stockDate").value ||
            new Date().toISOString().slice(0, 10);

          const sector = document.getElementById("stockSector").value || "ALL";

          const view = document.getElementById("stockView").value || "TOP10";

          const res = await fetch(
            `/api/dashboard/getStockData?date=${date}&sector=${encodeURIComponent(
              sector
            )}&view=${view}`
          );

          const json = await res.json();

          const sectorSelect = document.getElementById("stockSector");

          if (sectorSelect.options.length <= 1) {
            sectorSelect.innerHTML = "";

            json.sectors.forEach((sector) => {
              const option = document.createElement("option");
              option.value = sector;
              option.textContent = sector;
              sectorSelect.appendChild(option);
            });
          }


          const tbody = document.querySelector("#stockTable tbody");

          tbody.innerHTML = "";

          json.stocks.forEach((stock) => {
            const tr = document.createElement("tr");

            tr.className =
              stock.Direction === "Bullish" ? "bullish" : "bearish";

            tr.innerHTML = `
              <td>${stock.Rank}</td>
              <td>${stock.Sector}</td>
              <td>${stock.Company}</td>
              <td>${stock.LivePrice}</td>
              <td>${stock.DailyOpen}</td>
              <td>${stock.Gann90}</td>
              <td>${stock.Gann180}</td>
              <td>${stock.Gann270}</td>
              <td>${stock.Gann360}</td>
              <td>${stock.Position}</td>
              <td>${stock.Strength}</td>
              <td>${stock.Direction}</td>
              <td>${stock.CombinedScore}</td>
              <td>${stock.Signal}</td>
            `;

            tbody.appendChild(tr);
          });
        } catch (err) {
          console.error(err);
        }
      }
    
      loadData();
      loadStocks();

      setInterval(loadData,20000);
      setInterval(loadStocks,20000);